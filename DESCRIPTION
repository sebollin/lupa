Package: lupa
Title: Data Profiling and Quality Measurement
Version: 0.1.0
Authors@R:
    c(
      person("Sebastián", "Lucas", , "sebalucas@gmail.com", role = c("aut", "cre", "cph"),
             comment = c(ORCID = "0009-0009-9068-0276")),
      person("Robyn", "Speer", role = c("ctb", "cph"),
             comment = "byte tables, character categories, regular expressions and repair functions of the encoding-repair engine, translated from ftfy 6.3.1 (Apache-2.0)"),
      person("Nicholas", "Tierney", role = c("ctb", "cph"),
             comment = "missing-value sentinel values from naniar 1.1.0 (MIT)")
