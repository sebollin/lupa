Package: lupa
Title: Data Profiling and Quality Measurement
Version: 0.1.0
Authors@R:
    c(
      person("Sebastián", "Lucas", , "sebalucas@gmail.com", role = c("aut", "cre")),
      person("Robyn", "Speer", role = "cph"),
